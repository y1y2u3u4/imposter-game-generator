# ===========================================
# Imposter Game Generator - Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE (Multiplayer Rooms)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# ===========================================
# GOOGLE ANALYTICS 4
# ===========================================
# Get from: https://analytics.google.com
# Admin → Data Streams → Web → Measurement ID
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ===========================================
# PLAUSIBLE ANALYTICS
# ===========================================
# Privacy-friendly, GDPR compliant analytics
# Sign up at: https://plausible.io
# Your domain name (without https://)
VITE_PLAUSIBLE_DOMAIN=impostergamegenerators.com

# ===========================================
# MICROSOFT CLARITY
# ===========================================
# Session recordings & heatmaps
# Get from: https://clarity.microsoft.com
# Settings → Setup → Copy Project ID
VITE_CLARITY_PROJECT_ID=xxxxxxxxxx

# ===========================================
# AI IMAGE GENERATION (Optional)
# ===========================================
# For AI-generated word images
# VITE_OPENAI_API_KEY=sk-xxxxxxxxxx
